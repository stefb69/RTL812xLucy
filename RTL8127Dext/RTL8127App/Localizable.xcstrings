    "Driver needs your approval": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le pilote attend votre autorisation"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Treiber benötigt deine Zustimmung"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El controlador necesita tu autorización"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il driver richiede la tua autorizzazione"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ドライバの許可が必要です"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "驱动需要你的允许"
          }
        }
      }
    },
    "macOS asks you to allow it once. In System Settings, turn on the switch next to **RTL8127App**, then come back here.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS demande votre accord une seule fois. Dans Réglages Système, activez l'interrupteur à côté de **RTL8127App**, puis revenez ici."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS fragt einmalig um Erlaubnis. Aktiviere in den Systemeinstellungen den Schalter neben **RTL8127App** und komm dann hierher zurück."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS pide tu permiso una sola vez. En Ajustes del Sistema, activa el interruptor junto a **RTL8127App** y vuelve aquí."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS chiede il permesso una sola volta. In Impostazioni di Sistema, attiva l'interruttore accanto a **RTL8127App**, poi torna qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS が一度だけ許可を求めます。システム設定で **RTL8127App** の横のスイッチをオンにして、ここに戻ってください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 只会询问一次。请在系统设置中打开 **RTL8127App** 旁边的开关，然后回到这里。"
          }
        }
      }
    },
    "Open System Settings": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrir Réglages Système"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Systemeinstellungen öffnen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abrir Ajustes del Sistema"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri Impostazioni di Sistema"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システム設定を開く"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开系统设置"
          }
        }
      }
    },
    "Driver installed": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilote installé"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Treiber installiert"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Controlador instalado"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Driver installato"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ドライバはインストール済み"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "驱动已安装"
          }
        }
      }
    },
    "Loads automatically whenever a supported card is connected.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Se charge automatiquement dès qu'une carte compatible est branchée."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird automatisch geladen, sobald eine unterstützte Karte angeschlossen ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se carga automáticamente cuando se conecta una tarjeta compatible."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si carica automaticamente quando viene collegata una scheda supportata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "対応カードを接続すると自動的に読み込まれます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接受支持的网卡时会自动加载。"
          }
        }
      }
    },
    "Restart required": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Redémarrage nécessaire"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Neustart erforderlich"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es necesario reiniciar"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riavvio necessario"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再起動が必要です"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要重新启动"
          }
        }
      }
    },
    "The driver will be active after you restart your Mac.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le pilote sera actif après le redémarrage du Mac."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Treiber ist nach dem Neustart des Mac aktiv."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El controlador estará activo tras reiniciar el Mac."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il driver sarà attivo dopo il riavvio del Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac を再起動するとドライバが有効になります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新启动 Mac 后驱动即可生效。"
          }
        }
      }
    },
    "Installation failed": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Échec de l'installation"
          }
        },
        "de": {
