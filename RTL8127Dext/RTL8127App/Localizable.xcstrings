    "This driver is not installed; macOS drives the card itself. Install it only if you need jumbo frames (MTU up to 9000).": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce pilote n'est pas installé ; macOS gère la carte lui-même. Installez-le seulement si vous avez besoin des trames jumbo (MTU jusqu'à 9000)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Treiber ist nicht installiert; macOS steuert die Karte selbst. Installieren Sie ihn nur, wenn Sie Jumbo-Frames (MTU bis 9000) benötigen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este controlador no está instalado; macOS gestiona la tarjeta por sí mismo. Instálelo solo si necesita tramas jumbo (MTU hasta 9000)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo driver non è installato; macOS gestisce la scheda da solo. Installalo solo se ti servono i jumbo frame (MTU fino a 9000)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このドライバはインストールされていません。カードは macOS が直接制御しています。ジャンボフレーム（MTU 最大 9000）が必要な場合のみインストールしてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本驱动未安装，网卡由 macOS 自行驱动。仅在需要巨型帧（MTU 最高 9000）时才安装。"
          }
        }
      }
    },
