    "No link": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas de lien"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Verbindung"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin enlace"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun collegamento"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リンクなし"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无链路"
          }
        }
      }
    },
    "Configure it like any Ethernet port in System Settings › Network.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Configurez-la comme n'importe quel port Ethernet dans Réglages Système › Réseau."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Konfiguriere sie wie jeden Ethernet-Anschluss unter Systemeinstellungen › Netzwerk."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Configúrala como cualquier puerto Ethernet en Ajustes del Sistema › Red."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Configurala come qualsiasi porta Ethernet in Impostazioni di Sistema › Rete."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システム設定 › ネットワークで、通常の Ethernet ポートと同じように設定してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在系统设置 › 网络中像普通以太网端口一样进行配置。"
          }
        }
      }
    },
    "Check the cable, the SFP+ module or DAC, and the switch port.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez le câble, le module SFP+ ou DAC, et le port du switch."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüfe das Kabel, das SFP+-Modul bzw. DAC und den Switch-Port."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprueba el cable, el módulo SFP+ o DAC y el puerto del switch."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Controlla il cavo, il modulo SFP+ o DAC e la porta dello switch."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ケーブル、SFP+ モジュールまたは DAC、スイッチのポートを確認してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请检查线缆、SFP+ 模块或 DAC，以及交换机端口。"
          }
        }
      }
    },
