          }
        }
      }
    },
    "Try again": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réessayer"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erneut versuchen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reintentar"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riprova"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再試行"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重试"
          }
        }
      }
    },
    "%@ detected": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ détectée"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ erkannt"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ detectada"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ rilevata"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ を検出"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检测到 %@"
          }
        }
      }
    },
    "Connected via %@, driver attached.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Branchée en %@, pilote actif."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbunden über %@, Treiber aktiv."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conectada por %@, controlador activo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Collegata via %@, driver attivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ で接続、ドライバは動作中。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过 %@ 连接，驱动已加载。"
          }
        }
      }
    },
    "Connected via %@. Driver not attached yet — this can take a few seconds. If it stays like this, unplug and replug the card.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Branchée en %@. Le pilote n'est pas encore attaché, cela peut prendre quelques secondes. Si rien ne change, débranchez et rebranchez la carte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbunden über %@. Der Treiber ist noch nicht verbunden, das kann einige Sekunden dauern. Falls sich nichts ändert, Karte ab- und wieder anstecken."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conectada por %@. El controlador aún no está asociado; puede tardar unos segundos. Si no cambia, desconecta y vuelve a conectar la tarjeta."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Collegata via %@. Il driver non è ancora collegato, può richiedere qualche secondo. Se non cambia nulla, scollega e ricollega la scheda."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ で接続。ドライバはまだ接続されていません。数秒かかることがあります。変わらない場合はカードを抜き差ししてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过 %@ 连接。驱动尚未加载，可能需要几秒钟。如果一直如此，请拔下并重新插入网卡。"
          }
        }
      }
    },
    "Connected via %@. Finish the driver installation above.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Branchée en %@. Terminez d'abord l'installation du pilote ci-dessus."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbunden über %@. Schließe zuerst die Treiberinstallation oben ab."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conectada por %@. Termina primero la instalación del controlador."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Collegata via %@. Completa prima l'installazione del driver qui sopra."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ で接続。先に上のドライバのインストールを完了してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过 %@ 连接。请先完成上方的驱动安装。"
          }
        }
      }
    },
    "No card detected": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune carte détectée"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Karte erkannt"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se detecta ninguna tarjeta"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna scheda rilevata"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カードが見つかりません"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未检测到网卡"
          }
        }
      }
    },
    "Plug in the card (or the Thunderbolt enclosure holding it). It will show up here automatically.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Branchez la carte (ou le boîtier Thunderbolt qui la contient). Elle apparaîtra ici automatiquement."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schließe die Karte an (oder das Thunderbolt-Gehäuse, in dem sie steckt). Sie erscheint hier automatisch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecta la tarjeta (o la caja Thunderbolt que la contiene). Aparecerá aquí automáticamente."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Collega la scheda (o il box Thunderbolt che la contiene). Comparirà qui automaticamente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カード（またはカードを収めた Thunderbolt エンクロージャ）を接続してください。ここに自動的に表示されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请插入网卡（或装有网卡的雷雳扩展盒），它会自动显示在这里。"
          }
        }
      }
    },
    "Link up": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lien établi"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbindung aktiv"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Enlace activo"
          }
        },
        "it": {
          "stringUnit": {
