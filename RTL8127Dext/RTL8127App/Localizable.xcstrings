    "RTL8127 10GbE Driver": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilote RTL8127 10GbE"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "RTL8127 10GbE-Treiber"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Controlador RTL8127 10GbE"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Driver RTL8127 10GbE"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "RTL8127 10GbE ドライバ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "RTL8127 10GbE 驱动"
          }
        }
      }
    },
    "Realtek RTL8127 / RTL8127ATF (SFP+), RTL8126 and RTL8125 network cards.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cartes réseau Realtek RTL8127 / RTL8127ATF (SFP+), RTL8126 et RTL8125."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Realtek RTL8127 / RTL8127ATF (SFP+), RTL8126 und RTL8125 Netzwerkkarten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarjetas de red Realtek RTL8127 / RTL8127ATF (SFP+), RTL8126 y RTL8125."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Schede di rete Realtek RTL8127 / RTL8127ATF (SFP+), RTL8126 e RTL8125."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Realtek RTL8127 / RTL8127ATF (SFP+)、RTL8126、RTL8125 ネットワークカード。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Realtek RTL8127 / RTL8127ATF (SFP+)、RTL8126 和 RTL8125 网卡。"
          }
        }
      }
    },
