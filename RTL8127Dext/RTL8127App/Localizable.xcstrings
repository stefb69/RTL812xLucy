    "Link status appears once the driver is attached to a card.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'état du lien s'affiche une fois le pilote attaché à une carte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Verbindungsstatus erscheint, sobald der Treiber mit einer Karte verbunden ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El estado del enlace aparece cuando el controlador está asociado a una tarjeta."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo stato del collegamento compare quando il driver è collegato a una scheda."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ドライバがカードに接続されるとリンクの状態が表示されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
